# OpenAI — điền key của bạn. Để trống => agent dùng template fallback (vẫn chạy đủ pipeline).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Provider dự phòng (Anthropic Claude) — tự dùng khi key OpenAI hết hạn/sai, hết quota hoặc OpenAI lỗi.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Thứ tự failover
LLM_PROVIDERS=openai,anthropic

MAIN_DB_URL=postgresql+psycopg://lng:lng@localhost:5433/lng_main
EXTERNAL_DB_URL=postgresql+psycopg://lng:lng@localhost:5433/lng_external

TRAIN_CSV=LNG_market_training_2024_2025.csv
EVAL_CSV=LNG_market_evaluation_blintest model_2026_Jan_Feb.csv

# Bảo mật (xem README "Bảo mật & guardrails")
CORS_ORIGINS=http://localhost:5177
# Đặt giá trị => mọi API (trừ /health) yêu cầu header X-API-Key; frontend đọc VITE_API_TOKEN. Để trống = tắt (chỉ dùng local).
API_TOKEN=
# Số POST / phút / IP
RATE_LIMIT_PER_MIN=10
MAX_ACTIVE_RUNS=3
